#!/bin/sh
# Every commit raises the packaging version: CHANGELOG.md must be part of the commit and
# its newest version must differ from the one in HEAD. scripts/build.sh writes that
# version into the package description. (The package version itself follows Caddy.)

staged=$(git diff --cached --name-only)

abort()
{
    echo "" >&2
    echo "  ABORT: $1" >&2
    echo "  -> add a new version section to CHANGELOG.md" >&2
    echo "" >&2
    exit 1
}

echo "$staged" | grep -q '^CHANGELOG\.md$' || abort "CHANGELOG.md is not part of this commit."

new_version=$(git show :CHANGELOG.md | sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' | head -n 1)
old_version=$(git show HEAD:CHANGELOG.md 2>/dev/null | sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' | head -n 1)

[ -n "$new_version" ] || abort "no version section found in CHANGELOG.md."
[ "$new_version" != "$old_version" ] || abort "version $new_version is already in HEAD; every commit needs a new one."

exit 0